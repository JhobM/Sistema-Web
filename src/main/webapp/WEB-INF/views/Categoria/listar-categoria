<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Categorías</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="contenedor employee-layout">
<jsp:include page="/WEB-INF/views/fragments/menu-empleado.jsp" />
<div class="employee-content">
<header>
    <h1>Gestión de Categorías</h1>
</header>
<main>
    <nav>
        <a href="/Categoria/registrar-categoria">Registrar categoría</a>
    </nav>

    <h2>Lista de categorías</h2>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <c:forEach var="categoria" items="${categorias}">
                <tr>
                    <td>${categoria.id}</td>
                    <td>${categoria.nombre}</td>
                    <td>${categoria.descripcion}</td>
                    <td>${categoria.estado}</td>
                    <td>
                        <a href="/Categoria/editar-categoria?id=${categoria.id}">
                            Editar
                        </a>
                        |
                        <a href="/Categoria/desactivar-categoria?id=${categoria.id}">
                            Desactivar
                        </a>
                    </td>
                </tr>
            </c:forEach>
        </tbody>
    </table>
</main>
</div>
</div>
</body>
</html>


