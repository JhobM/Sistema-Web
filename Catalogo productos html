<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catálogo de productos</title>
    <link rel="stylesheet" href="../styles.css">
</head>
<body>
    <header>
        <h1>Catálogo de productos</h1>
    </header>

    <main>
        <nav>
            <a href="../IntPr/tienda.html">Inicio</a> |
            <a href="../IntPr/carrito.html">Carrito</a>
        </nav>

        <form>
            <label for="buscar">Buscar producto</label>
            <input type="text" id="buscar" placeholder="Nombre del producto">

            <label for="categoria">Categoría</label>
            <select id="categoria">
                <option>Todas</option>
                <option>Polos</option>
                <option>Pantalones</option>
                <option>Casacas</option>
            </select>

            <button type="submit">Buscar</button>
        </form>

        <table>
            <tr>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acción</th>
            </tr>
            <tr>
                <td>Polo Oversize</td>
                <td>Polos</td>
                <td>S/ 49.90</td>
                <td>12</td>
                <td><a href="detalle-producto.html">Ver detalle</a></td>
            </tr>
            <tr>
                <td>Casaca Denim</td>
                <td>Casacas</td>
                <td>S/ 89.90</td>
                <td>5</td>
                <td><a href="detalle-producto.html">Ver detalle</a></td>
            </tr>
        </table>
    </main>
</body>
</html>
